# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: any free-tier Gemini model. "gemini-flash-latest" always points to the current Flash model.
GEMINI_MODEL=gemini-flash-latest

# Optional (V2 only): set to 1 to play without any API calls (rule-based parser + plain narration).
OFFLINE_MODE=0
